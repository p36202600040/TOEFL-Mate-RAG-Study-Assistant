# ── TOEFL Mate — Environment Variables ──
# Salin file ini menjadi .env dan isi nilainya.
# JANGAN commit file .env ke source control.

# Groq API Key — dapatkan di https://console.groq.com/keys
GROQ_API_KEY=

# Model Groq — sesuaikan dengan model yang tersedia
# Lihat https://console.groq.com/docs/models
GROQ_MODEL=llama-3.1-8b-instant

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval
TOP_K=5
RELEVANCE_THRESHOLD=1.5

# UI defaults
DEFAULT_LANGUAGE=Indonesia
DEFAULT_STYLE=penjelasan bertahap
DEFAULT_LEVEL=menengah

